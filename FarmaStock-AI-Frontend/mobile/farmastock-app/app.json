{
  "expo": {
    "name": "FarmaStock AI",
    "slug": "farmastock-ai",
    "version": "1.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.farmastock.demo",
      "permissions": [
        "INTERNET"
      ],
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#F7FAF9"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "42795bb7-7f4c-47f8-9608-29c89e7a9481"
      }
    },
    "icon": "./assets/icon.png"
  }
}
